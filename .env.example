# ===========================================
# Важно: Этот файл — шаблон. На сервере нужно скопировать его в .env и заполнить актуальными значениями.
# ===========================================

# ===========================================
# Fun&Sun Banner Generator - Переменные окружения
# ===========================================

# -------------------------------------------
# СЕРВЕР
# -------------------------------------------
PORT=3000
NODE_ENV=production

# -------------------------------------------
# ДОМЕН (для генерации правильных URL)
# -------------------------------------------
BASE_URL=https://banners.yourdomain.com

# -------------------------------------------
# ПУТИ К ПАПКАМ
# -------------------------------------------
TEMPORARY_DIR=./temporary
OUTPUT_DIR=./output

# -------------------------------------------
# ОЧИСТКА ВРЕМЕННЫХ ФАЙЛОВ
# -------------------------------------------
# Через сколько часов удалять временные AI-изображения
MAX_TEMP_AGE_HOURS=1

# Через сколько дней удалять готовые баннеры
MAX_OUTPUT_AGE_DAYS=7

# -------------------------------------------
# TELEGRAM BOT (если бот на этом же сервере)
# -------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=123456789

# -------------------------------------------
# AI SERVICE (нейросеть для изображений)
# -------------------------------------------
AI_SERVICE_URL=https://api.your-ai-service.com
AI_SERVICE_KEY=your_api_key_here