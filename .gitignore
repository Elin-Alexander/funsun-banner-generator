# ===========================================
# Fun&Sun Banner Generator - Git Ignore
# ===========================================

# -------------------------------------------
# ЗАВИСИМОСТИ
# -------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# -------------------------------------------
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# -------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# -------------------------------------------
# СГЕНЕРИРОВАННЫЕ ФАЙЛЫ
# -------------------------------------------
output/*.png
output/*.jpg
output/*.jpeg
output/*.webp
output/banner_url.txt
temporary/*
!output/.gitkeep
!temporary/.gitkeep

# -------------------------------------------
# ЛОГИ
# -------------------------------------------
*.log
logs/
pm2.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------------------
# IDE И РЕДАКТОРЫ
# -------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -------------------------------------------
# ВРЕМЕННЫЕ ФАЙЛЫ
# -------------------------------------------
tmp/
temp/
.cache/
dist/
build/

# -------------------------------------------
# ТЕСТИРОВАНИЕ
# -------------------------------------------
coverage/
.nyc_output/
*.cover